[Desktop Entry]
Type=Application
Name=SmolSlime Configurator installieren (Arch)
Comment=Lädt die neueste Version und installiert sie (Menüeintrag, USB-Rechte, fehlende Pakete)
Icon=system-software-install
Exec=env SMOLSLIME_FROM_WEB=1 bash -c "curl -fsSL -o /tmp/SmolSlime-installieren.sh https://github.com/LucyWolf/SmolSlimeConfigurator/releases/latest/download/SmolSlime-installieren.sh || { kdialog --error \"Download fehlgeschlagen. Besteht eine Internetverbindung?\" || zenity --error --text=\"Download fehlgeschlagen. Besteht eine Internetverbindung?\"; exit 1; }; bash /tmp/SmolSlime-installieren.sh"
Terminal=false
Categories=Utility;
